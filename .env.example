# Local development defaults. docker compose works without a .env file; copy this to
# .env only to change something. Never commit real secrets.

# Shared by local Supabase Auth (signs tokens) and the API (verifies them). >= 32 chars.
SUPABASE_JWT_SECRET=local-dev-jwt-secret-change-me-at-least-32-chars
# service_role JWT signed with the secret above (local only). The API uses it to delete
# the sign-in identity when an account is deleted.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtbG9jYWwiLCJpYXQiOjE3NjcyMjU2MDAsImV4cCI6MjA4Mjc1ODQwMH0.OVTA9qgofuhwpm9mbrmBHnvNn59wWHJYzd775xsIhaI
# true = skip email confirmation on sign-up. Emails (confirmation, recovery) land in
# Mailpit at http://localhost:8025 either way.
MAILER_AUTOCONFIRM=false

RATE_LIMIT_SALT=local-dev-salt
CLEANUP_TOKEN=local-dev-cleanup-token
# Seconds between scheduled cleanup runs.
CLEANUP_INTERVAL_SECONDS=3600
